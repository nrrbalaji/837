# Server Configuration
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database Configuration
DB_USER=postgres
DB_HOST=10.1.9.161
DB_NAME=Claim837
DB_PASSWORD=hlnotes
DB_PORT=5434

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2023-12-01-preview

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# SFTP Configuration
SFTP_PORT=2222
SFTP_HOST=0.0.0.0

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security
BCRYPT_ROUNDS=10
CORS_ORIGIN=http://localhost:5173

# Monitoring
LOG_LEVEL=info
LOG_DIR=./logs

# Payer Configuration
DEFAULT_PAYER_TIMEOUT=30000
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=1000

# =====================================================
# Multi-Mode Ingestion Configuration
# =====================================================

# Encryption Key for SFTP Passwords (32 bytes = 64 hex characters)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here_change_in_production

# SFTP Ingestion Settings
SFTP_MAX_RETRIES=3
SFTP_BASE_RETRY_DELAY_MS=5000
SFTP_CONNECTION_TIMEOUT_SECONDS=30
SFTP_DEFAULT_POLL_INTERVAL_SECONDS=300

# Local Folder Ingestion Settings
LOCAL_MAX_RETRIES=3
LOCAL_BASE_RETRY_DELAY_MS=5000
LOCAL_DEBOUNCE_MS=2000

# Temporary Directories
TEMP_DIR=./temp
STAGING_DIR=./temp/staging
OUTPUT_DIR=./output
